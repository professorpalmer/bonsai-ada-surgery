+        std::lock_guard<std::mutex> lock(g_tier_mutex);
+        for (size_t i = 0; i < g_tier_recs.size(); ++i) {
+            if (g_tier_recs[i].get() == rec.get()) {
+                g_tier_recs.erase(g_tier_recs.begin() + i);

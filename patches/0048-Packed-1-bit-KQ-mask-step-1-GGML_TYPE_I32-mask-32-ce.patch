+// Packed KQ mask (GGML_TYPE_I32): one bit per (token, cell), 32 cells per word along the cell axis, bit set =
+// attend. Same predicate as the f16 fill above (empty cell, other sequence, causal, M-RoPE, SWA), without the
+// ALiBi value form (the graph never asks for a packed mask with ALiBi). Same per-sequence row reuse.
+template<bool causal, bool swa, bool is_2d>
+static void set_input_kq_mask_packed_impl(const args_set_input_kq_mask & args, uint32_t * data) {
+    const auto & ubatch  = args.ubatch;
+
+    const auto & v_cells       = args.v_cells;
+    const auto & seq_to_stream = args.seq_to_stream;
+
+    const uint32_t       n_swa    = args.n_swa;
+    const llama_swa_type swa_type = args.swa_type;
+
+    const int64_t n_kv     = args.n_kv;
+    const int64_t n_words  = n_kv / 32;
+    const int64_t n_stream = args.n_stream;
+    const int64_t n_tps    = args.n_tps;
+
+    llama_pos seq_pos_min[LLAMA_MAX_SEQ];
+    std::fill(seq_pos_min, seq_pos_min + LLAMA_MAX_SEQ, INT32_MAX);
+
+    for (uint32_t i = 0; i < ubatch->n_tokens; ++i) {
+        const llama_seq_id seq_id = ubatch->seq_id[i][0];
+
+        seq_pos_min[seq_id] = std::min(seq_pos_min[seq_id], ubatch->pos[i]);
+    }
+
+    for (uint32_t s = 0; s < n_stream; ++s) {
+        std::unordered_map<llama_seq_id, uint32_t>              seq_srct;
+        std::unordered_map<llama_seq_id, std::vector<uint32_t>> seq_idxs;
+
+        for (uint32_t ii = 0; ii < n_tps; ++ii) {
+            const uint32_t i = s*n_tps + ii;
+
+            const llama_seq_id seq_id = ubatch->seq_id[i][0];
+
+            const auto & cells = v_cells.at(seq_to_stream[seq_id]);
+
+                  llama_pos p0 = -1;
+            const llama_pos p1 = ubatch->pos[i];
+
+            const llama_pos p1_x = is_2d ? ubatch->pos[i + ubatch->n_tokens*2] : 0;
+            const llama_pos p1_y = is_2d ? ubatch->pos[i + ubatch->n_tokens]   : 0;
+
+            uint32_t * row = data + n_words*i;
+
+            bool prev = false;
+
+            auto & idxs = seq_idxs[seq_id];
+
+            if (seq_srct.find(seq_id) != seq_srct.end()) {
+                const uint32_t * row_prev = data + n_words*seq_srct[seq_id];
+
+                std::copy(row_prev, row_prev + n_words, row);
+
+                prev = true;
+            } else {
+                std::fill(row, row + n_words, 0u);
+
+                idxs.clear();
+                idxs.reserve(ubatch->n_tokens + n_swa + 32);
+
+                seq_srct[seq_id] = i;
+            }
+
+            for (uint32_t jj = 0; jj < n_kv; ++jj) {
+                uint32_t j = jj;
+
+                if (prev) {
+                    if (jj >= idxs.size()) {
+                        break;
+                    }
+
+                    j = idxs[jj];
+                }
+
+                bool keep = !cells.is_empty(j) && cells.seq_has(j, seq_id);
+
+                if (keep) {
+                    p0 = cells.pos_get(j);
+
+                    if (!prev) {
+                        if (p0 + (int32_t) (n_swa + 32) >= seq_pos_min[seq_id]) {
+                            idxs.push_back(j);
+                        }
+                    }
+
+                    if (causal) {
+                        if (p0 > p1) {
+                            keep = false;
+                        } else if (is_2d && p0 == p1) {
+                            const auto & p0_ext = cells.ext_get(j);
+
+                            if (p0_ext.is_2d_gt(p1_x, p1_y)) {
+                                keep = false;
+                            }
+                        }
+                    }
+
+                    if (keep && swa) {
+                        if (llama_hparams::is_masked_swa(n_swa, swa_type, p0, p1)) {
+                            keep = false;
+                        }
+                    }
+                }
+
+                const uint32_t bit = 1u << (j & 31);
+                if (keep) {
+                    row[j >> 5] |= bit;
+                } else {
+                    row[j >> 5] &= ~bit;
+                }
+            }
+        }
+    }
+}
+
+static void set_input_kq_mask_packed(const args_set_input_kq_mask & args, uint32_t * data, bool causal_attn) {
+    const bool swa   = args.swa_type != LLAMA_SWA_TYPE_NONE;
+    const bool is_2d = args.ubatch->is_pos_2d();
+    if (causal_attn) {
+        if (swa) { is_2d ? set_input_kq_mask_packed_impl<true,  true,  true >(args, data) : set_input_kq_mask_packed_impl<true,  true,  false>(args, data); }
+        else     { is_2d ? set_input_kq_mask_packed_impl<true,  false, true >(args, data) : set_input_kq_mask_packed_impl<true,  false, false>(args, data); }
+    } else {
+        if (swa) { is_2d ? set_input_kq_mask_packed_impl<false, true,  true >(args, data) : set_input_kq_mask_packed_impl<false, true,  false>(args, data); }

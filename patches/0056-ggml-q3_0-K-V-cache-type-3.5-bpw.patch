+        const float d  = max / -4;
+        const float id = d ? 1.0f/d : 0.0f;
+
+        y[i].d = GGML_FP32_TO_FP16(d);
+
+        memset(y[i].qs, 0, sizeof(y[i].qs));
+
+        for (int j = 0; j < qk; ++j) {
+            const float x0 = x[i*qk + j]*id;
+
+            const uint8_t q = MIN(7, (int8_t)(x0 + 4.5f));
+
+            y[i].qs[j%8]     |= (q & 3) << (2*(j/8));
+            y[i].qs[8 + j%4] |= (q >> 2) << (j/4);
+        }
+    }

From 92a05282c0ec7953d93a49ef445d5ac7b79b3dd2 Mon Sep 17 00:00:00 2001
From: Cary Palmer <24235924+professorpalmer@users.noreply.github.com>
Date: Sun, 18 Oct 2026 14:13:48 -0500
Subject: [PATCH 68/69] server + llama: delta slot saves (save pos_min: only
 attention cells at or after it; restore append: add the cells after the
 slot's; /props slot_save_delta)

---
 src/llama-context.cpp           | 29 +++++++++++++--
 src/llama-context.h             |  6 ++--
 src/llama-ext.h                 | 16 +++++++++
 src/llama-io.h                  |  4 +++
 src/llama-kv-cache.cpp          | 14 +++++---
 src/llama-kv-cache.h            |  2 +-
 tools/server/server-context.cpp | 63 +++++++++++++++++++++++++--------
 tools/server/server-task.h      |  2 ++
 8 files changed, 112 insertions(+), 24 deletions(-)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 872dbc6360..5e833d60b2 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -3389,7 +3389,7 @@ bool llama_context::state_save_file(const char * filepath, const llama_token * t
     return true;
 }
 
-size_t llama_context::state_seq_load_file(llama_seq_id seq_id, const char * filepath, llama_token * tokens_out, size_t n_token_capacity, size_t * n_token_count_out) {
+size_t llama_context::state_seq_load_file(llama_seq_id seq_id, const char * filepath, llama_token * tokens_out, size_t n_token_capacity, size_t * n_token_count_out, llama_state_seq_flags flags) {
     llama_file file(filepath, "rb");
 
     // version checks
@@ -3431,7 +3431,7 @@ size_t llama_context::state_seq_load_file(llama_seq_id seq_id, const char * file
     {
         const size_t state_size = file.size() - file.tell();
         llama_io_read_file io(&file);
-        const size_t nread = state_seq_read_data(io, seq_id, 0);
+        const size_t nread = state_seq_read_data(io, seq_id, flags);
         if (!nread) {
             LLAMA_LOG_ERROR("%s: failed to restore sequence state\n", __func__);
             return 0;
@@ -3443,7 +3443,7 @@ size_t llama_context::state_seq_load_file(llama_seq_id seq_id, const char * file
     return file.tell();
 }
 
-size_t llama_context::state_seq_save_file(llama_seq_id seq_id, const char * filepath, const llama_token * tokens, size_t n_token_count) {
+size_t llama_context::state_seq_save_file(llama_seq_id seq_id, const char * filepath, const llama_token * tokens, size_t n_token_count, llama_pos pos_min) {
     llama_file file(filepath, "wb");
 
     file.write_u32(LLAMA_STATE_SEQ_MAGIC);
@@ -3455,6 +3455,7 @@ size_t llama_context::state_seq_save_file(llama_seq_id seq_id, const char * file
 
     // save the context state using stream saving
     llama_io_write_file io(&file);
+    io.pos_min = pos_min;
     state_seq_write_data(io, seq_id, 0);
 
     const size_t res = file.tell();
@@ -4450,6 +4451,28 @@ size_t llama_state_seq_load_file(llama_context * ctx, const char * filepath, lla
     }
 }
 
+size_t llama_state_seq_save_file_from(llama_context * ctx, const char * filepath, llama_seq_id seq_id, llama_pos pos_min, const llama_token * tokens, size_t n_token_count) {
+    ctx->synchronize();
+
+    try {
+        return ctx->state_seq_save_file(seq_id, filepath, tokens, n_token_count, pos_min);
+    } catch (const std::exception & err) {
+        LLAMA_LOG_ERROR("%s: error saving sequence state file: %s\n", __func__, err.what());
+        return 0;
+    }
+}
+
+size_t llama_state_seq_load_file_ext(llama_context * ctx, const char * filepath, llama_seq_id dest_seq_id, llama_token * tokens_out, size_t n_token_capacity, size_t * n_token_count_out, llama_state_seq_flags flags) {
+    ctx->synchronize();
+
+    try {
+        return ctx->state_seq_load_file(dest_seq_id, filepath, tokens_out, n_token_capacity, n_token_count_out, flags);
+    } catch (const std::exception & err) {
+        LLAMA_LOG_ERROR("%s: error loading sequence state file: %s\n", __func__, err.what());
+        return 0;
+    }
+}
+

From f5693f08cdc0da341b443cf77017d4195dbf4fb5 Mon Sep 17 00:00:00 2001
From: Cary Palmer <24235924+professorpalmer@users.noreply.github.com>
Date: Wed, 18 Nov 2026 17:18:29 -0500
Subject: [PATCH 74/79] cuda: tiered K/V: write back all host runs of a
 redirected set_rows

One tiered buffer holds K then V of a layer (2 equal parts) in 2 MiB pages.
When the K tensor is not a whole number of pages, the last page of the K
host tail also holds the first cells of V. V then has two host runs: that
page and its own tail. On the prompt-read path (no CUDA graph) set_rows
writes through the staging alias and a kernel copies the rows to the host
pages. That kernel got only the first host run of the tensor, so the V rows
of the tail stayed in staging and the host pages kept their old bytes. The
next batch staged the old bytes: wrong V for all cells past the VRAM line
that a prompt batch wrote. K was correct. Decode steps with a CUDA graph
write in place and were correct.

Condition: kv_size x row bytes not a multiple of 2 MiB, and V with a VRAM
head. q4_0 / q8_0 rows: n_ctx not a multiple of 32,768. f16: not a
multiple of 1,024.

Fix: ggml_cuda_tier_step launches the write-back for each host run that
the tensor meets.

tests/test-kv-tier.cpp (no model file, build-only target): K + V q4_0,
10,240 cells x 576 bytes (K 5.625 MiB), VRAM fraction 0.25, 6 steps of
256-row set_rows and one attention op over all cells, against an ordinary
device buffer. Before: 669 of 10,240 V rows differ (first cell 4,323, the
start of the V host tail), attention output different at 2 of 6 steps.
After: all bytes and all outputs equal.

RTX 4070, a 2-bit Qwen3.8-27B quant (measured on this engine):
- llama-perplexity, 2 chunks, -b 512, line 2,048: q4_0 -c 6144 all cells
  6.0658, line before 6.1718, line after 6.0658. f16 -c 5376 all cells
  6.4994, line after 6.4994.
- llama-server, top-10 logprobs of the first token after 11 prompts of 40k
  to 58k tokens, -c 61440, line 16,384 against all cells: before 0/11
  equal, after 11/11 equal. -c 65536 (whole pages) was 11/11 before.

(cherry picked from commit e2ded3d68d703ac6f81fb94dbabd127a1cd77138)
---
 ggml/src/ggml-cuda/ggml-cuda.cu |  31 +++--
 tests/CMakeLists.txt            |   3 +
 tests/test-kv-tier.cpp          | 201 ++++++++++++++++++++++++++++++++
 3 files changed, 223 insertions(+), 12 deletions(-)
 create mode 100644 tests/test-kv-tier.cpp

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index db0eaa1d2..2cf802163 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -854,8 +854,6 @@ struct ggml_cuda_tier_redirect {
     void *       data;     // the node's own address, restored after the write-back
     const void * entry;    // ggml_cuda_tier_entry of the tiered buffer
     size_t       base;     // offset of the node's data in the tiered buffer
-    size_t       h_lo;     // host run of the node's range, as offsets from base
-    size_t       h_hi;
 };
 struct ggml_cuda_tier_state {
     std::vector<ggml_cuda_tier_redirect> rd; // set_rows nodes that write through the alias, in graph order
@@ -2256,7 +2254,7 @@ static void ggml_cuda_tier_graph_begin(ggml_backend_cuda_context & ctx, ggml_cud
                 const bool flat = idx && (idx->type == GGML_TYPE_I64 || idx->type == GGML_TYPE_I32) && ggml_is_contiguous(idx) &&
                     idx->ne[1] == 1 && idx->ne[2] == 1 && idx->ne[3] == 1 && n->ne[2] == 1 && n->ne[3] == 1;
                 if (redirect_on && flat) {
-                    ts.rd.push_back({ i, n, n->data, e, base, a - base, b - base });
+                    ts.rd.push_back({ i, n, n->data, e, base });
                 } else {
                     all_redirected = false;
                 }
@@ -2301,16 +2299,25 @@ static void ggml_cuda_tier_step(ggml_backend_cuda_context & ctx, ggml_cuda_tier_
         const size_t row_bytes = ggml_row_size(n->type, n->ne[0]);
         const size_t align = (size_t) r.base | (size_t) n->nb[1] | row_bytes;
         const int    vec = align % 16 == 0 ? 16 : align % 4 == 0 ? 4 : 1;
-        if (idx->ne[0] == 0) {
-            // nothing written
-        } else if (idx->type == GGML_TYPE_I64) {
-            k_tier_write_back<<<(unsigned) idx->ne[0], 128, 0, ctx.stream()>>>(alias, orig, (const int64_t *) idx->data,
-                n->nb[1], row_bytes, r.h_lo, r.h_hi, vec);
-        } else {
-            k_tier_write_back<<<(unsigned) idx->ne[0], 128, 0, ctx.stream()>>>(alias, orig, (const int32_t *) idx->data,
-                n->nb[1], row_bytes, r.h_lo, r.h_hi, vec);
+        // One launch for each host run that the node's range meets. A tensor can meet more than one: when the size of
+        // a part is not a multiple of the page size, the last page of the K tail holds the first cells of V, so V has
+        // that page and its own tail. (With only the first run, the V rows of the tail stayed in staging and the host
+        // pages kept their old bytes: wrong V for all cells past the line that a prefill batch wrote.)
+        const size_t n_lo = r.base, n_hi = std::min(e->total, r.base + ggml_nbytes(n));
+        for (auto & hr : e->host_runs) {
+            const size_t a = std::max(n_lo, hr.first), b = std::min(n_hi, hr.first + hr.second);
+            if (a >= b || idx->ne[0] == 0) {
+                continue;
+            }
+            if (idx->type == GGML_TYPE_I64) {
+                k_tier_write_back<<<(unsigned) idx->ne[0], 128, 0, ctx.stream()>>>(alias, orig, (const int64_t *) idx->data,
+                    n->nb[1], row_bytes, a - r.base, b - r.base, vec);
+            } else {
+                k_tier_write_back<<<(unsigned) idx->ne[0], 128, 0, ctx.stream()>>>(alias, orig, (const int32_t *) idx->data,
+                    n->nb[1], row_bytes, a - r.base, b - r.base, vec);
+            }
+            CUDA_CHECK(cudaGetLastError());
         }
-        CUDA_CHECK(cudaGetLastError());
         r.node->data = r.data;
     }
     if (ts.inflight && ts.rd_next < ts.rd.size() && ts.rd[ts.rd_next].at <= i + 4) {

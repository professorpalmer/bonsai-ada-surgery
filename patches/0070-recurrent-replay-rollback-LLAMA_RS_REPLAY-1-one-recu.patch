+            ggml_cuda_pool_alloc<float> s_mid(ctx.pool(), S_v * S_v * H * n_seqs);
+            ggml_cuda_pool_alloc<float> g_act(ctx.pool());
+            ggml_cuda_pool_alloc<float> b_act(ctx.pool());

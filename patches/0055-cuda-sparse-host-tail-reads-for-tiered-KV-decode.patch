+static bool fa_sparse_maybe_tracked(const void * p, size_t n) {
+    const uintptr_t a = (uintptr_t) p;
+    return a < fa_sparse_hi.load(std::memory_order_relaxed) && a + n > fa_sparse_lo.load(std::memory_order_relaxed);

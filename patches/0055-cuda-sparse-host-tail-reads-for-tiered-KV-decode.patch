+            to_fp16(kd, Kh.get(), D, nc, H_kv, 1, K->nb[1]/ts, K->nb[2]/ts, K->nb[3]/ts, stream);
+            fa_sparse_bounds<<<dim3(np, H_kv), 256, 2*D*sizeof(float), stream>>>(Kh.get(), mx_w, mn_w, sc_w, D, (int) nc, page, p0, stride_pages);
+        }
+    }

+            }
+        }
+    }
+    std::lock_guard<std::mutex> lock(fa_sparse_mtx);
+    fa_sparse_dirty_locked(p, ggml_nbytes(dst), rows.empty() ? nullptr : &rows, (size_t) dst->nb[1]);
+}

+        ggml_cuda_pool_alloc<half> Kh(ctx.pool(), (size_t) D*buf_cells*H_kv);
+        const size_t ts = ggml_type_size(K->type);
+        to_fp16_nc_cuda_t to_fp16 = ggml_get_to_fp16_nc_cuda(K->type);
+        GGML_ASSERT(to_fp16 != nullptr);

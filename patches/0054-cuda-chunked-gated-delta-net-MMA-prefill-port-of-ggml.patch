 ggml/src/ggml-cuda/gated-delta-net-mma.cuh |  37 ++
 ggml/src/ggml-cuda/gated_delta_net.cu      | 153 +++++++
 ggml/src/ggml-cuda/mma.cuh                 |  90 ++++-
 tests/test-backend-ops.cpp                 |  24 ++

     static std::mutex m;
-    static std::map<int, std::pair<CUmemGenericAllocationHandle, size_t>> handles;
+    static std::map<std::pair<std::string, int>, std::pair<CUmemGenericAllocationHandle, size_t>> handles;
     std::lock_guard<std::mutex> lock(m);
